{
  "name": "auto",
  "note": "부가 서비스에서 복귀한 뒤 새 계좌의 은행, 계좌번호, 금액을 직접 입력하고 본인 확인 후 명시적으로 실행합니다.",
  "derived_from_original": false,
  "required_ids": [
    "phone",
    "dn-amt",
    "acc-input",
    "acc-pad",
    "acc-next",
    "amt-pad",
    "amt-next",
    "pwpad",
    "execute"
  ],
  "steps": [
    {
      "screen": "home"
    },
    {
      "screen": "services",
      "click": "[data-screen='home'] [data-action='services']"
    },
    {
      "screen": "recipient",
      "do": [
        {
          "click": "[data-action='back-services']"
        },
        {
          "click": "[data-action='go-recipient']"
        }
      ]
    },
    {
      "screen": "account",
      "click": "[data-action='go-account']"
    },
    {
      "screen": "bank",
      "click": "[data-action='open-bank']"
    },
    {
      "screen": "amount",
      "do": [
        {
          "click": "[data-action='pick-bank'][data-bank='{BANK}']"
        },
        {
          "type": "{ACCOUNT}",
          "key": "[data-action='acc-num'][data-v='%s']"
        },
        {
          "click": "#acc-next"
        }
      ]
    },
    {
      "screen": "review",
      "do": [
        {
          "type": "{AMOUNT}",
          "key": "[data-action='num'][data-v='%s']"
        },
        {
          "click": "#amt-next"
        }
      ]
    },
    {
      "screen": "verify",
      "click": "[data-action='send']"
    },
    {
      "screen": "done",
      "do": [
        {
          "repeat": 4,
          "click": "#pwpad [data-action='pw']",
          "wait": 0.15
        },
        {
          "click": "#execute"
        }
      ]
    }
  ],
  "expect": {},
  "error_paths": [
    {
      "id": "wrong-account",
      "from_step": "account",
      "inputs": [
        {
          "click": "[data-action='open-bank']"
        },
        {
          "click": "[data-action='pick-bank'][data-bank='{BANK}']"
        },
        {
          "click": "[data-action='acc-clear']"
        },
        {
          "click": "[data-action='dialog-yes']"
        },
        {
          "type": "{ACCOUNT_WRONG}",
          "key": "[data-action='acc-num'][data-v='%s']"
        },
        {
          "click": "#acc-next"
        }
      ],
      "expect_screen": "account",
      "expect_text_any": [
        "계좌번호가 올바르지 않습니다",
        "계좌번호를 확인해 주세요"
      ],
      "recover": [
        {
          "click": "[data-action='fix-account']"
        }
      ],
      "back_to": "account"
    },
    {
      "id": "wrong-bank",
      "from_step": "review",
      "inputs": [
        {
          "click": "[data-screen='review'] [data-action='edit-bank']"
        },
        {
          "click": "[data-action='pick-bank'][data-bank='{BANK_WRONG}']"
        },
        {
          "click": "[data-action='send']"
        }
      ],
      "expect_screen": "review",
      "expect_text_any": [
        "선택한 은행이 받는 계좌의 은행과 맞지 않습니다"
      ],
      "recover": [
        {
          "click": "#bank-error [data-action='edit-bank']"
        }
      ],
      "back_to": "bank"
    }
  ],
  "reveal": {
    "pick-bank": {
      "at": "bank",
      "do": [
        {
          "click": "[data-action='clear-search']"
        },
        {
          "click": "[data-action='tab-sec']"
        },
        {
          "click": "[data-action='tab-bank']"
        }
      ]
    },
    "edit-recipient-memo": {
      "at": "review",
      "do": [
        {
          "click": "[data-action='memo-toggle']"
        }
      ]
    },
    "edit-my-memo": {
      "at": "review",
      "do": [
        {
          "click": "[data-action='memo-toggle']"
        }
      ]
    }
  }
}