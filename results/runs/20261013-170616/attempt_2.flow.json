{
  "name": "auto",
  "note": "빈 계좌번호와 금액을 직접 입력하고 은행 선택, 내용 확인, 비밀번호 네 자리 입력을 거쳐 완료한다.",
  "derived_from_original": false,
  "required_ids": [
    "phone",
    "dn-amt",
    "acc-input",
    "acc-pad",
    "acc-next",
    "amt-pad",
    "amt-next",
    "pwpad",
    "account-error",
    "bank-error"
  ],
  "steps": [
    {
      "screen": "home"
    },
    {
      "screen": "recipient",
      "click": "[data-action='go-recipient']"
    },
    {
      "screen": "account",
      "click": "[data-action='go-account']"
    },
    {
      "screen": "bank",
      "do": [
        {
          "type": "{ACCOUNT}",
          "key": "[data-action='acc-num'][data-v='%s']"
        },
        {
          "click": "[data-action='open-bank']"
        }
      ]
    },
    {
      "screen": "account",
      "click": "[data-action='pick-bank'][data-bank='{BANK}']"
    },
    {
      "screen": "amount",
      "click": "#acc-next"
    },
    {
      "screen": "confirm",
      "do": [
        {
          "type": "{AMOUNT}",
          "key": "[data-action='num'][data-v='%s']"
        },
        {
          "click": "#amt-next"
        }
      ]
    },
    {
      "screen": "password",
      "click": "[data-action='send']"
    },
    {
      "screen": "done",
      "do": [
        {
          "repeat": 4,
          "click": "#pwpad [data-action='pw']",
          "wait": 0.15
        }
      ]
    }
  ],
  "expect": {},
  "reveal": {
    "pick-bank": {
      "at": "bank",
      "do": [
        {
          "click": "[data-action='tab-sec']"
        },
        {
          "click": "[data-action='search-clear']"
        },
        {
          "click": "[data-action='tab-bank']"
        },
        {
          "click": "[data-action='search-clear']"
        }
      ]
    }
  },
  "error_paths": [
    {
      "id": "wrong-account",
      "from_step": "account",
      "inputs": [
        {
          "click": "[data-action='acc-clear']"
        },
        {
          "click": "[data-action='dialog-yes']"
        },
        {
          "type": "{ACCOUNT_WRONG}",
          "key": "[data-action='acc-num'][data-v='%s']"
        },
        {
          "click": "[data-action='open-bank']"
        },
        {
          "click": "[data-action='pick-bank'][data-bank='{BANK}']"
        },
        {
          "click": "#acc-next"
        }
      ],
      "expect_screen": "account",
      "expect_text_any": [
        "계좌번호가 맞지 않습니다",
        "계좌번호를 다시 확인"
      ],
      "recover": [
        {
          "click": "[data-action='fix-account']"
        }
      ],
      "back_to": "account"
    },
    {
      "id": "wrong-bank",
      "from_step": "confirm",
      "inputs": [
        {
          "click": "[data-action='edit-account']"
        },
        {
          "click": "[data-action='open-bank']"
        },
        {
          "click": "[data-action='pick-bank'][data-bank='{BANK_WRONG}']"
        },
        {
          "click": "#acc-next"
        },
        {
          "click": "#amt-next"
        },
        {
          "click": "[data-action='send']"
        }
      ],
      "expect_screen": "confirm",
      "expect_text_any": [
        "선택한 은행이 받는 계좌의 은행과 맞지 않습니다",
        "은행을 다시 선택"
      ],
      "recover": [
        {
          "click": "[data-action='fix-bank']"
        }
      ],
      "back_to": "bank"
    }
  ]
}