{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["es2020", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["@figma/plugin-typings", "node"]
  },
  "include": ["src", "scripts"]
}
